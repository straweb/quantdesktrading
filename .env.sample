# ============================================================
# Trading Terminal — environment template
# Copy to .env and edit:   cp .env.sample .env
# (.env is NEVER included in the workspace download zip)
# ============================================================

# ---------- security ----------
APP_SECRET=change-me-terminal-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- ports ----------
# Next.js frontend  : 3000 (fixed, gateway/Caddy entry :81 -> 3000)
# FastAPI REST      : 8000 — tool interactions only
# socket.io WS      : 8001 — tick/candle/funds/order stream
# NOTE: keep values comment-free on the SAME line; put notes on their own line.
PYAPI_PORT=8000
PYWS_PORT=8001

# ---------- trading mode ----------
# sandbox | live  (LIVE ONLY detaches sim/sandbox feeds automatically)
DEFAULT_TRADING_MODE=sandbox

# ---------- data plane tuning ----------
# TICK_FANOUT_MIN_MS: tick coalescing window (ms) — lower = more granular
# FUNDS_CACHE_TTL_S : funds burst dedupe (funds are on-demand + event-driven)
TICK_FANOUT_MIN_MS=80
FUNDS_CACHE_TTL_S=3
CANDLE_HISTORY_FALLBACK_DAYS=3

# ============================================================
# Broker credentials (optional here; accounts UI stores them
# per-account in the backend DB — these are defaults only)
# ============================================================

# --- ICICI Direct (Breeze) ---
# api_key / api_secret from developer portal; session_token from TOTP login.
# Sessions are persisted in DB and REUSED (no re-login on refresh).
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# --- Dhan ---
# access_token from web.dhan.co (My Profile -> DhanHQ APIs)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Shoonya (Finvasia) ---
SHOONYA_UID=
SHOONYA_PASSWORD=
SHOONYA_TOTP=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_API_SECRET=
